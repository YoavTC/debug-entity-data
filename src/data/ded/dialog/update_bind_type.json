{
	"type": "minecraft:multi_action",
	"title": "",
	"body": {
		"type": "plain_message",
		"contents": {
			"entity": "@n[tag=ded.temp_update_bind_type]",
			"nbt": "data.path"
		}
	},
	"inputs": [
		{
			"type": "minecraft:text",
			"key": "key",
			"label": "NBT Data Path (e.g. Health)"
		}
	],
	"can_close_with_escape": true,
	"after_action": "close",
	"pause": true,
	"actions": [
		{
			"label": "Update Bind",
			"action": {
				"type": "minecraft:dynamic/run_command",
				"template": "function ded:internal_type/update_debug {key:'$(key)'}"
			}
		},
		{
			"label": "Remove",
			"action": {
				"type": "minecraft:run_command",
				"command": "function ded:internal_type/remove_debug"
			}
		}
	]
}